# Copier ce fichier en ".env" (backend/.env) puis remplir les valeurs.
# Ne JAMAIS publier le vrai fichier .env sur GitHub.
# Adapter les noms ci-dessous à ceux réellement lus dans backend/.../settings.py.

# --- Django ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données PostgreSQL ---
# Exemple local :
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/plateforme_cours

# --- Front / sessions (développement local) ---
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

DEMO_PROF_PASSWORD=change-me
DEMO_STUDENT_PASSWORD=change-me